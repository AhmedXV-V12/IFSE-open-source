# install.sh / install.ps1 write .env for you. To do it by hand: copy this
# file to .env, edit it, and run: docker compose up -d --build

# Who can open the search site: 0.0.0.0 = every network (LAN, server,
# internet), 127.0.0.1 = this machine only
SEARCH_BIND=0.0.0.0
SEARCH_PORT=5000

# The indexer dashboard controls the index: keep it on 127.0.0.1 unless a
# firewall or VPN protects it
INDEXER_BIND=127.0.0.1
INDEXER_PORT=5101

# The site's public address if it has a domain (used by the dashboard's
# "Customize the site" link); empty = same host as the dashboard
SEARCH_URL=

# Password for the dashboard and /owner. Left empty, the indexer writes one
# to its data volume on first start.
IFSE_ADMIN_TOKEN=
IFSE_RATE_PER_MIN=120
